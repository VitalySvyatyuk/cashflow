# Скопировать в .env.prod на сервере. deploy/deploy.sh создаёт его сам со случайными паролями.
SITE_DOMAIN=emelyanova-play.online
# Другие домены того же сайта (через запятую) — их же добавить в ALLOWED_HOSTS и CSRF
EXTRA_DOMAINS="emelyanova-play.ru, www.emelyanova-play.ru"

DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=emelyanova-play.online,emelyanova-play.ru,www.emelyanova-play.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://emelyanova-play.online,https://emelyanova-play.ru,https://www.emelyanova-play.ru

POSTGRES_DB=cashflow
POSTGRES_USER=cashflow
POSTGRES_PASSWORD=
